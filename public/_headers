# Cloudflare static asset headers. Hashed build files never change, so browsers can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The signed-in app and one-off links stay out of search results (public pages: /, /welcome, /terms, /privacy)
/auth
  X-Robots-Tag: noindex
/link/*
  X-Robots-Tag: noindex
/overlay/*
  X-Robots-Tag: noindex
/leaderboard
