{
  "name": "spotbot-3-0-22",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/*, /mcp and AI-app sign-in (/oauth/*, /.well-known/*, and /auth/callback, which the Worker
    // passes back to the SPA unless it is an AI-app sign-in) must reach the Worker first.
    "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/*", "/auth/callback"]
  },
  // FUNCTIONS_ORIGIN / OPS_ORIGIN are set in the Cloudflare dashboard; without this
  // every deploy from a merge wipes them and all /api/functions calls return 503.
  "keep_vars": true,
  // Lets Cloudflare's `wrangler preview` build a preview for each PR branch.
  "previews": {}
}
